# RetailPulse environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env with real secrets to version control.

# --- PostgreSQL ---
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=changeme_in_env_file
POSTGRES_DB=retailpulse
PGHOST=localhost
PGPORT=5432

# --- Airflow ---
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__UNIT_TEST_MODE=False
AIRFLOW_VAR_RETAILPULSE_DB_CONN=postgresql+psycopg2://retailpulse:changeme_in_env_file@postgres:5432/retailpulse

# --- dbt ---
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# --- Olist dataset ---
OLIST_DATA_DIR=./data/olist
OLIST_DOWNLOAD_URL=https://cdn.kaggleusercontent.com/... # replace with official Kaggle/Olist source URL

# --- Power BI REST API (Entra ID client credentials) ---
# Obtain these from Microsoft Entra ID (Azure AD) app registration.
POWERBI_TENANT_ID=your-tenant-id
POWERBI_CLIENT_ID=your-client-id
POWERBI_CLIENT_SECRET=your-client-secret
POWERBI_WORKSPACE_ID=your-workspace-id
POWERBI_DATASET_ID=your-semantic-model-id
POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg
POWERBI_REFRESH_TIMEOUT_SECONDS=300
POWERBI_REFRESH_POLL_INTERVAL_SECONDS=15

# --- Pipeline ---
PIPELINE_SCHEDULE_CRON=0 2 * * *
PIPELINE_RETRIES=2
PIPELINE_RETRY_DELAY_SECONDS=30
