    { "id": "int_models", "type": "backend", "label": "Intermediate", "sublabel": "Order Aggregations", "stage": 2, "row": 1, "tag": "tables" },
    { "id": "marts_models", "type": "database", "label": "Star Schema", "sublabel": "Facts & Dimensions", "stage": 3, "row": 1, "tag": "incremental" },
